# Переменные окружения (скопировать в .env)

# PostgreSQL — эти же переменные читает контейнер postgres при первом запуске
POSTGRES_USER=bloktea
POSTGRES_PASSWORD=bloktea
POSTGRES_DB=bloktea
# для локального запуска бэкенда вне docker; в compose хост переопределяется на db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis — хранилище refresh-сессий; в compose хост переопределяется на redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# логировать SQL-запросы
SQL_ECHO=false

# авторизация; секрет сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true, если стенд работает по https
REFRESH_COOKIE_SECURE=false
