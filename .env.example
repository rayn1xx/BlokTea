# Переменные окружения (скопировать в .env)

# PostgreSQL: эти же переменные читает контейнер postgres при первом запуске
POSTGRES_USER=bloktea
POSTGRES_PASSWORD=bloktea
POSTGRES_DB=bloktea
# для локального запуска бэкенда вне docker; в compose хост переопределяется на db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis: хранилище refresh-сессий; в compose хост переопределяется на redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# логировать SQL-запросы
SQL_ECHO=false

# авторизация; секрет сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true, если стенд работает по https
REFRESH_COOKIE_SECURE=false

# сервис моков внешних систем (Альфа-Бизнес, ЕГРЮЛ/ЕГРИП, МСП, БКИ, ФНС); в compose адрес переопределяется на mocks
MOCKS_BASE_URL=http://localhost:8100
# выключить системы в моке для сценария «источник недоступен»: MOCKS_DOWN=bki,fns
MOCKS_DOWN=

# demo_code в ответах challenge и демо-учётки; пароль демо-учёток: alfa2026
DEMO_MODE=true
# при старте контейнера создать демо-данные, если базы ещё нет (сброс: make reset-demo)
SEED_DEMO=true

# ИИ: пока все тексты на шаблонах-заглушках, /health отдаёт llm: stub
LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_TEXT=qwen3.5:9b
LLM_MODEL_VISION=
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.1

# допущения прототипа (docs/scoring-decision.md)
RATE_PERCENT_DEFAULT=15
LOAD_THRESHOLD_PERCENT=30
LOAD_TARGET_PERCENT=26.5

# куда бэкенд кладёт загруженные документы
UPLOAD_DIR=data/uploads
