# Куда dev-сервер Vite проксирует запросы /api
VITE_API_PROXY_TARGET=http://localhost:8000

# true: демо-учётки (petr.smirnov, analyst и другие) обслуживает MSW прямо в браузере.
# Остальные пользователи и запросы без демо-токена идут на настоящий бэкенд.
# false: моков нет совсем, всё идёт на бэкенд
USE_MOCKS=true

# true: панель «Войти как…» и код подтверждения рядом с полем
DEMO_MODE=true
